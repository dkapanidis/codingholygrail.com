{
  "name": "www-codingholygrail-com",
  "compatibility_date": "2026-09-14",
  // No Worker script: asset requests are free and unmetered.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "www.codingholygrail.com", "custom_domain": true }]
}
